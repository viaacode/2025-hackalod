#Cats
# SELECT distinct ?item ?itemLabel
prefix schema: <https://schema.org/>
CONSTRUCT {
  ?s schema:identifier ?id.
   ?rkiri schema:identifier ?id
}
# select distinct ?s ?occLabel
WHERE
{
     ?s wdt:P9152 ?id;
#         wdt:P106 ?occ
      OPTIONAL {
        ?s wdt:P9152 ?rkid
           BIND(iri(concat('https://rkd.nl/artists/', ?rkid))as ?rkiri)
        }
        SERVICE wikibase:label { bd:serviceParam wikibase:language "nl,en". } # Helps get the label in your language, if not, then default for all languages, then en language
}
# Invoke-WebRequest -Uri "https://query.wikidata.org/sparql?query=%23Cats%0A%23%20SELECT%20distinct%20%3Fitem%20%3FitemLabel%0Aprefix%20schema%3A%20%3Chttps%3A%2F%2Fschema.org%2F%3E%0ACONSTRUCT%20%7B%0A%20%20%3Fs%20schema%3Aidentifier%20%3Fid.%0A%20%20%20%3Frkiri%20schema%3Aidentifier%20%3Fid%0A%7D%0A%23%20select%20distinct%20%3Fs%20%3FoccLabel%0AWHERE%0A%7B%0A%20%20%20%20%20%3Fs%20wdt%3AP9152%20%3Fid%3B%0A%23%20%20%20%20%20%20%20%20%20wdt%3AP106%20%3Focc%0A%20%20%20%20%20%20OPTIONAL%20%7B%0A%20%20%20%20%20%20%20%20%3Fs%20wdt%3AP9152%20%3Frkid%0A%20%20%20%20%20%20%20%20%20%20%20BIND(iri(concat('https%3A%2F%2Frkd.nl%2Fartists%2F'%2C%20%3Frkid))as%20%3Frkiri)%0A%20%20%20%20%20%20%20%20%7D%0A%20%20%20%20%20%20%20%20SERVICE%20wikibase%3Alabel%20%7B%20bd%3AserviceParam%20wikibase%3Alanguage%20%22nl%2Cen%22.%20%7D%20%23%20Helps%20get%20the%20label%20in%20your%20language%2C%20if%20not%2C%20then%20default%20for%20all%20languages%2C%20then%20en%20language%0A%7D" -Headers @{ "Accept" = "text/turtle" } -OutFile Gelder-wikidata.ttl 
