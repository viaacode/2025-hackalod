prefix schema: <https://schema.org/>
prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>
prefix skos: <http://www.w3.org/2004/02/skos/core#>
prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
# select distinct ?s
construct {
  ?s
    schema:url ?jp2url
    .
}
where {
  {
    values ?type {
      <https://data.rkd.nl/thesaurus/66733>
    }
    ?s <http://www.cidoc-crm.org/cidoc-crm/P2_has_type> ?type.
    ?s <http://www.cidoc-crm.org/cidoc-crm/P129i_is_subject_of>/rdf:rest*/rdf:first/<http://www.cidoc-crm.org/cidoc-crm/P129i_is_subject_of>/<https://linked.art/ns/terms/access_point> ?url
    BIND(concat(str(?url), '/full/max/0/default.jpg')as ?jp2url)
  }
  union
  {
    values ?material {
      <https://data.rkd.nl/thesaurus/61784>
    }
    ?s <http://www.cidoc-crm.org/cidoc-crm/P45_consists_of> ?material;
      .
    ?s <http://www.cidoc-crm.org/cidoc-crm/P129i_is_subject_of>/rdf:rest*/rdf:first/<http://www.cidoc-crm.org/cidoc-crm/P129i_is_subject_of>/<https://linked.art/ns/terms/access_point> ?url 
    BIND(concat(str(?url), '/full/max/0/default.jpg')as ?jp2url)
  }
}